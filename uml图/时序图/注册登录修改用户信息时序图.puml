@startuml
skinparam defaultFontSize 30
skinparam titleFontSize 30
title 注册、登录与用户信息维护时序图

actor 用户 as User
boundary "前端用户页面\n(注册/登录/个人资料)" as Frontend
control "统一接口层\n/v1/auth/*" as API
control "认证服务 / 用户服务" as AuthService
database "MySQL 数据库" as DB

User -> Frontend : 发起用户操作
activate Frontend

Frontend -> API : 提交请求\n(注册/登录/资料修改、用户参数)
activate API

API -> AuthService : 转发用户请求
activate AuthService

alt 注册
    AuthService -> AuthService : 校验用户名、密码、显示名称等参数合法性
    AuthService -> DB : 检查用户名是否已存在
    activate DB
    DB --> AuthService : 返回检查结果
    deactivate DB

    AuthService -> DB : 写入新用户信息并分配默认角色
    activate DB
    DB --> AuthService : 保存成功
    deactivate DB

    AuthService --> API : 返回注册结果

else 登录
    AuthService -> DB : 查询用户账户信息
    activate DB
    DB --> AuthService : 返回用户记录
    deactivate DB

    AuthService -> AuthService : 校验用户名与密码
    AuthService -> AuthService : 生成访问令牌与刷新令牌

    AuthService --> API : 返回登录结果与认证令牌

else 用户信息维护
    AuthService -> AuthService : 校验当前用户身份
    AuthService -> AuthService : 校验显示名称/密码等修改内容合法性

    AuthService -> DB : 更新用户资料或密码信息
    activate DB
    DB --> AuthService : 更新成功
    deactivate DB

    AuthService --> API : 返回更新结果
end

deactivate AuthService
API --> Frontend : 返回处理结果
deactivate API

Frontend --> User : 展示注册/登录/资料维护结果
deactivate Frontend

@enduml