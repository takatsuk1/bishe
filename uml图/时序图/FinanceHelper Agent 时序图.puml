@startuml
title FinanceHelper Agent 处理时序图

actor 用户 as User
boundary "前端页面" as Frontend
control "FinanceHelper Agent" as Agent
control "工作流启动器\nStartWorkflow" as Starter
control "财务任务识别节点" as AnalyzeNode
control "条件判断节点" as CondNode
control "MySQL 工具节点" as MysqlNode
control "mysql_exec MCP 工具" as MysqlTool
control "AkShare 工具节点" as AkshareNode
control "AkShare MCP 工具" as AkshareTool
control "结果分析聊天模型节点" as SummaryNode

User -> Frontend : 提交财务/金融问题
activate Frontend

Frontend -> Agent : 发送用户输入
activate Agent

Agent -> Starter : 启动默认财务工作流
activate Starter
Starter --> Agent : 返回工作流上下文
deactivate Starter

Agent -> AnalyzeNode : 识别任务类型\n(账单查询 / 数据库处理 / 金融数据获取)
activate AnalyzeNode
AnalyzeNode --> Agent : 返回任务分类结果
deactivate AnalyzeNode

Agent -> CondNode : 根据任务类型分流
activate CondNode
CondNode --> Agent : 返回执行路径
deactivate CondNode

alt 本地财务数据处理
    Agent -> MysqlNode : 进入 MySQL 工具阶段
    activate MysqlNode
    MysqlNode -> MysqlTool : 执行 mysql_exec / SQL 查询
    activate MysqlTool
    MysqlTool --> MysqlNode : 返回数据库结果
    deactivate MysqlTool
    MysqlNode --> Agent : 返回财务数据
    deactivate MysqlNode
else 金融数据分析/行情查询
    Agent -> AkshareNode : 进入 AkShare 工具阶段
    activate AkshareNode
    AkshareNode -> AkshareTool : 根据 tool_name 与 arguments 调用金融子工具
    activate AkshareTool
    AkshareTool --> AkshareNode : 返回金融数据
    deactivate AkshareTool
    AkshareNode --> Agent : 返回金融分析原始数据
    deactivate AkshareNode
end

Agent -> SummaryNode : 结合工具结果生成财务分析与最终回答
activate SummaryNode
SummaryNode --> Agent : 返回最终财务结论
deactivate SummaryNode

Agent --> Frontend : 返回结果
deactivate Agent

Frontend --> User : 展示财务处理结果
deactivate Frontend
@enduml