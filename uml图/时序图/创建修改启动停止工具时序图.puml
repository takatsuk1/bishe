@startuml
title 工具创建、修改、启动、停止时序图

actor 用户 as User
boundary "前端工具管理页面" as Frontend
control "统一接口层\n/v1/orchestrator/user-tools/*" as API
control "认证服务" as Auth
control "工具服务" as ToolService
database "MySQL 数据库" as DB
control "进程管理器 / MCP 工具运行器" as ProcessMgr

User -> Frontend : 发起工具操作
activate Frontend

Frontend -> API : 提交工具请求\n(创建/修改/启动/停止、工具参数、令牌)
activate API

API -> Auth : 校验身份与工具管理权限
activate Auth
Auth --> API : 校验通过
deactivate Auth

API -> ToolService : 转发工具操作请求
activate ToolService

alt 创建工具
    ToolService -> ToolService : 校验 tool_id、名称、参数与配置合法性
    ToolService -> ToolService : 检查工具标识是否重复

    ToolService -> DB : 写入新工具配置
    activate DB
    DB --> ToolService : 保存成功
    deactivate DB

    ToolService --> API : 返回创建结果

else 修改工具
    ToolService -> DB : 读取原工具配置
    activate DB
    DB --> ToolService : 返回工具记录
    deactivate DB

    ToolService -> ToolService : 校验工具归属、配置合法性与参数有效性

    ToolService -> DB : 更新工具配置
    activate DB
    DB --> ToolService : 更新成功
    deactivate DB

    ToolService --> API : 返回修改结果

else 启动工具
    ToolService -> DB : 读取工具配置与运行模式
    activate DB
    DB --> ToolService : 返回工具信息
    deactivate DB

    ToolService -> ToolService : 校验工具是否支持启动\n(通常为 MCP 类工具)

    alt 工具可启动
        ToolService -> ProcessMgr : 按配置启动本地 MCP 工具进程
        activate ProcessMgr
        ProcessMgr --> ToolService : 返回启动结果、端口/进程信息
        deactivate ProcessMgr

        ToolService -> DB : 回写工具运行状态
        activate DB
        DB --> ToolService : 更新成功
        deactivate DB

        ToolService --> API : 返回启动成功结果
    else 工具不可启动
        ToolService --> API : 返回启动失败/无需启动结果
    end

else 停止工具
    ToolService -> DB : 读取工具运行状态
    activate DB
    DB --> ToolService : 返回工具配置与运行信息
    deactivate DB

    alt 工具处于运行状态
        ToolService -> ProcessMgr : 停止对应 MCP 工具进程
        activate ProcessMgr
        ProcessMgr --> ToolService : 返回停止结果
        deactivate ProcessMgr

        ToolService -> DB : 更新工具状态为已停止
        activate DB
        DB --> ToolService : 更新成功
        deactivate DB

        ToolService --> API : 返回停止成功结果
    else 工具未运行
        ToolService --> API : 返回无需停止结果
    end
end

deactivate ToolService
API --> Frontend : 返回工具操作结果
deactivate API

Frontend --> User : 展示最新工具信息与运行状态
deactivate Frontend

@enduml