@startuml
skinparam defaultFontSize 30
skinparam titleFontSize 30
title BaziHelper Agent 处理时序图

actor 用户 as User
boundary "前端页面" as Frontend
control "BaziHelper Agent" as Agent
control "N_start\n开始节点" as StartNode
control "N_extract\n聊天模型节点" as ExtractNode
control "N_bazi\n工具节点" as BaziNode
control "bazi 工具" as BaziTool
control "N_summary\n聊天模型节点" as SummaryNode
control "N_end\n结束节点" as EndNode

User -> Frontend : 提交黄历/八字问题
activate Frontend

Frontend -> Agent : 发送用户输入
activate Agent

Agent -> StartNode : 进入 N_start
activate StartNode
StartNode --> Agent : 开始处理
deactivate StartNode

Agent -> ExtractNode : 进入 N_extract\n按 extract_bazi_request 提取结构化请求
activate ExtractNode
ExtractNode --> Agent : 返回适合工具调用的 JSON 参数
deactivate ExtractNode

Agent -> BaziNode : 进入 N_bazi
activate BaziNode
BaziNode -> BaziTool : 调用 bazi 工具执行查询
activate BaziTool
BaziTool --> BaziNode : 返回黄历/八字结果
deactivate BaziTool
BaziNode --> Agent : 返回查询结果
deactivate BaziNode

Agent -> SummaryNode : 进入 N_summary\n按 summarize_bazi_result 整理结果
activate SummaryNode
SummaryNode --> Agent : 返回解释性输出
deactivate SummaryNode

Agent -> EndNode : 进入 N_end
activate EndNode
EndNode --> Agent : 返回最终结果
deactivate EndNode

Agent --> Frontend : 输出处理结果
deactivate Agent

Frontend --> User : 展示黄历/八字结果
deactivate Frontend
@enduml