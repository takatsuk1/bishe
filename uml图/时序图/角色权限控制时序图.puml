@startuml
skinparam defaultFontSize 30
skinparam titleFontSize 30
title 角色权限控制时序图

actor "系统管理员" as Admin
boundary "前端后台管理页面" as Frontend
control "统一接口层\n/v1/admin/users/{id}/roles" as API
control "认证服务" as Auth
control "权限服务" as PermissionService
database "MySQL 数据库" as DB

Admin -> Frontend : 修改用户角色 / 权限配置
activate Frontend

Frontend -> API : 提交权限变更请求\n(目标用户、角色/权限配置、令牌)
activate API

API -> Auth : 校验管理员身份
activate Auth
Auth --> API : 校验通过
deactivate Auth

API -> PermissionService : 转发权限变更请求
activate PermissionService

PermissionService -> PermissionService : 校验目标角色合法性
PermissionService -> PermissionService : 校验权限范围与操作合法性

PermissionService -> DB : 写入新的角色关系或权限配置
activate DB
DB --> PermissionService : 更新成功
deactivate DB

PermissionService --> API : 返回更新结果
deactivate PermissionService

API --> Frontend : 返回角色/权限更新结果
deactivate API

Frontend -> Frontend : 刷新用户权限信息
Frontend --> Admin : 展示最新角色与权限状态
deactivate Frontend

@enduml