@startchen
title 多智能体协作平台整体 E-R 图

left to right direction

entity "users" as Users {
  id
  user_id
  status
}

entity "role" as Role {
  id
  role_code
}

entity "user_tool" as UserTool {
  id
  tool_id
  user_id
  name
  config
}

entity "user_workflow" as UserWorkflow {
  id
  workflow_id
  user_id
  name
  status
}

entity "user_agent" as UserAgent {
  id
  agent_id
  user_id
  workflow_id
  name
}

entity "monitor_run" as MonitorRun {
  id
  run_id
  workflow_id
  user_id
  source_agent_id
  task_id
  status
}

entity "monitor_event" as MonitorEvent {
  id
  event_id
  run_id
  event_type
}

entity "monitor_alert" as MonitorAlert {
  id
  alert_id
  run_id
  alert_type
  content
}

relationship "分配" as AssignRole {
}

relationship "创建工具" as CreateTool {
}

relationship "创建工作流" as CreateWorkflow {
}

relationship "创建智能体" as CreateAgent {
}

relationship "绑定" as BindWorkflow {
}

relationship "产生运行" as HasRun {
}

relationship "记录事件" as HasEvent {
}

relationship "触发告警" as HasAlert {
}

Users -N- AssignRole
AssignRole -1- Role

Users -1- CreateTool
CreateTool -N- UserTool

Users -1- CreateWorkflow
CreateWorkflow -N- UserWorkflow

Users -1- CreateAgent
CreateAgent -N- UserAgent

UserWorkflow -1- BindWorkflow
BindWorkflow -1- UserAgent

UserWorkflow -1- HasRun
HasRun -N- MonitorRun

MonitorRun -1- HasEvent
HasEvent -N- MonitorEvent

MonitorRun -1- HasAlert
HasAlert -N- MonitorAlert

@endchen