@startuml
skinparam defaultFontSize 32
skinparam titleFontSize 32
title 后端整体全局类图

skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
hide circle

interface Agent {
  + Run(ctx, input): Result
}

interface Tool {
  + Name(): string
  + Call(ctx, args): Result
}

class ChatServer {
  - authService: AuthService
  - executor: WorkflowExecutor
  - storage: Storage
  + ChatCompletion(req): Response
  + StreamChatCompletion(req): Stream
}

class WorkflowExecutor {
  - toolRegistry: ToolRegistry
  - storage: Storage
  - runManager: RunManager
  + ExecuteWorkflow(def, input): Result
  + ExecuteWorkflowFromDefinition(def, input): Result
}


class HostAgent {
  - toolRegistry: ToolRegistry
  + Run(ctx, input): Result
}

abstract class SpecializedAgent {
  - toolRegistry: ToolRegistry
  + Run(ctx, input): Result
}

class DeepResearchAgent
class URLReaderAgent
class LBSHelperAgent
class FinanceHelperAgent
class BaziHelperAgent
class ResumeCustomizerAgent
class InterviewSimulatorAgent
class CareerRadarAgent

class HTTPTool {
  - method: string
  - url: string
  + Name(): string
  + Call(ctx, args): Result
}

class MCPTool {
  - config: MCPToolConfig
  + Name(): string
  + Call(ctx, args): Result
}

class ToolRegistry {
  - tools: map
  + RegisterTool(tool): void
  + GetTool(name): Tool
  + ListTools(): []Tool
}

class WorkflowDefinition {
  + ID: string
  + Name: string
  + StartNodeID: string
  + Nodes: []NodeDef
  + Edges: []EdgeDef
}



ChatServer --> WorkflowExecutor : 依赖

WorkflowExecutor --> ToolRegistry : 依赖
WorkflowExecutor --> RunManager : 依赖
WorkflowExecutor --> Storage : 依赖
WorkflowExecutor *-- WorkflowDefinition
WorkflowDefinition *-- NodeDef
WorkflowDefinition *-- EdgeDef

Agent <|.. HostAgent
Agent <|.. SpecializedAgent

SpecializedAgent <|-- DeepResearchAgent
SpecializedAgent <|-- URLReaderAgent
SpecializedAgent <|-- LBSHelperAgent
SpecializedAgent <|-- FinanceHelperAgent
SpecializedAgent <|-- BaziHelperAgent
SpecializedAgent <|-- ResumeCustomizerAgent
SpecializedAgent <|-- InterviewSimulatorAgent
SpecializedAgent <|-- CareerRadarAgent

HostAgent --> ToolRegistry : 使用
SpecializedAgent --> ToolRegistry : 使用

Tool <|.. HTTPTool
Tool <|.. MCPTool
ToolRegistry o-- Tool

HostAgent ..> Agent : 调度
CareerRadarAgent ..> DeepResearchAgent : 调用
@enduml